# Lead capture — POST /api/leads sends an email when these are set.
# Without them, leads are still captured in Vercel function logs.

# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives lead notification emails.
LEADS_TO_EMAIL=

# Verified sender on your Resend domain. Defaults to leads@bayline.example
# (which won't deliver in production — set this to a real verified address).
LEADS_FROM_EMAIL=
